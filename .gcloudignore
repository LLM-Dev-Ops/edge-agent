# Ignore files for gcloud functions deploy
# Cloud Function: edge-agents (nodejs20)

# Git
.git/
.gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo

# Rust build artifacts (not needed for Cloud Function)
target/
dist/
Cargo.toml
Cargo.lock
crates/
src/

# Node modules (re-installed during deploy)
node_modules/

# Documentation (not needed for build)
*.md
!README.md

# Local config files
.env
.env.*
*.local

# Test files (not needed for deploy)
**/*_test.rs
**/tests/
test/
tests/

# Deployment configs (not needed inside the function)
deployments/
Dockerfile
docker-compose*.yml
.dockerignore

# Scripts not needed for Cloud Function
scripts/
bin/

# Editor backups
*~
*.bak

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Claude config
.claude/
.claude-flow/

# MCP config
.mcp.json

# Plans and docs directories
plans/
docs/
