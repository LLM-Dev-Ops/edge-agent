# LLM-Edge-Agent Environment Configuration
# Copy to .env and update values for your environment
#
# DEPLOYMENT TARGET: Google Cloud Run
# SERVICE: llm-edge-agent (unified service)

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================
SERVICE_NAME=llm-edge-agent
SERVICE_VERSION=0.1.0
HOST=0.0.0.0
PORT=8080

# Environment: dev | staging | prod
PLATFORM_ENV=prod

# =============================================================================
# RUVECTOR SERVICE (Persistence Layer)
# =============================================================================
# LLM-Edge-Agent does NOT connect directly to Google SQL.
# ALL persistence flows through ruvector-service.

# RuVector service endpoint (Cloud Run internal URL)
RUVECTOR_SERVICE_URL=https://ruvector-service-HASH-uc.a.run.app

# RuVector API key for authentication
RUVECTOR_API_KEY=your-ruvector-api-key-here

# RuVector client settings
RUVECTOR_TIMEOUT_SECS=5
RUVECTOR_MAX_RETRIES=3
RUVECTOR_RETRY_DELAY_MS=100

# =============================================================================
# TELEMETRY (LLM-Observatory)
# =============================================================================
TELEMETRY_ENDPOINT=https://observatory-HASH-uc.a.run.app
OTEL_EXPORTER_OTLP_ENDPOINT=https://observatory-HASH-uc.a.run.app

# =============================================================================
# LOGGING
# =============================================================================
RUST_LOG=llm_edge_agents=info,tower_http=info
RUST_BACKTRACE=0

# =============================================================================
# GOOGLE CLOUD CONFIGURATION
# =============================================================================
GOOGLE_CLOUD_PROJECT=agentics-dev
GOOGLE_CLOUD_REGION=us-central1

# =============================================================================
# NOTE: The following are NOT used by LLM-Edge-Agent
# (Included here for reference - these are handled by other services)
# =============================================================================
# OPENAI_API_KEY - handled by llm-edge-proxy (not edge-agent)
# ANTHROPIC_API_KEY - handled by llm-edge-proxy (not edge-agent)
# DATABASE_URL - handled by ruvector-service (not edge-agent)
